cloud-architecture-diagram

direction right
typeface clean
styleMode shadow
colorMode pastel

GlobalEntry [label: "Global Entry", color: blue] {
  DNS [label: "Route 53"]
  CloudFront [icon: aws-cloudfront, label: "CloudFront"]
}

Primary [label: "Primary Region - Mumbai", color: green] {
  PrimaryApp [icon: aws-fargate, label: "ECS Fargate"]
  PrimaryDB [icon: aws-rds, label: "RDS PostgreSQL Multi-AZ"]
  PrimaryS3 [icon: aws-simple-storage-service, label: "S3"]
  PrimaryECR [label: "ECR"]
  PrimarySecrets [label: "Secrets Manager"]
}

DR [label: "DR Region - Hyderabad", color: orange] {
  DRNetwork [label: "Pre-provisioned VPC, ALB and IAM"]
  DRApp [icon: aws-fargate, label: "ECS Fargate Standby"]
  DRDB [icon: aws-rds, label: "Cross-Region Read Replica"]
  DRS3 [icon: aws-simple-storage-service, label: "S3 Recovery Copy"]
  DRECR [label: "ECR Replica"]
  DRSecrets [label: "Secrets Replica"]
}

Recovery [label: "Recovery Control", color: red] {
  Health [label: "Health and Replication Checks"]
  Decision [label: "Human-authorized Regional Failover"]
  Runbook [label: "Automated DR Runbook"]
}

DNS > CloudFront: Customer entry
CloudFront > PrimaryApp: Normal traffic
PrimaryApp > PrimaryDB: Transactional access
PrimaryApp > PrimaryS3: Object access

PrimaryDB > DRDB: Asynchronous cross-Region replication
PrimaryS3 > DRS3: Replication and recovery copy
PrimaryECR > DRECR: Image replication
PrimarySecrets > DRSecrets: Secret replication

Health > PrimaryApp: Check application health
Health > PrimaryDB: Check primary database
Health > DRDB: Check replication lag
Health > Decision: Provide recovery evidence
Decision > Runbook: Declare regional disaster

Runbook > DRDB: Promote replica
Runbook > DRApp: Scale recovery services
DRECR > DRApp: Pull known-good images
DRSecrets > DRApp: Load regional secrets
DRApp > DRDB: Transactional access
DRApp > DRS3: Object access
Runbook > CloudFront: Switch origin to recovery region

legend [position: bottom-left] {
  [color: green, label: "Primary region"]
  [color: orange, label: "Recovery region"]
  [color: red, label: "Recovery control"]
}
