cloud-architecture-diagram

direction right
typeface clean
styleMode shadow
colorMode pastel

Production Workloads [color: green] {
  ECS [icon: aws-fargate, label: "ECS/Fargate Services"]
  ALB [label: "Application Load Balancer"]
  RDS [icon: aws-rds, label: "RDS PostgreSQL"]
  Queues [icon: aws-simple-queue-service, label: "SQS"]
  Cache [icon: aws-elasticache, label: "Valkey"]
}

Telemetry [color: blue] {
  OTel [label: "OpenTelemetry / ADOT"]
  Metrics [label: "CloudWatch Metrics"]
  Logs [label: "CloudWatch Logs"]
  Traces [label: "Distributed Traces"]
  ContainerInsights [label: "Container Insights"]
}

Service Health [color: purple] {
  SLO [label: "SLIs / SLOs"]
  Dashboards [label: "Service + Business Dashboards"]
  Alarms [label: "Actionable Alarms"]
}

Operations [color: orange] {
  OnCall [label: "On-call"]
  Runbooks [label: "Runbooks"]
  Incident [label: "Incident / Postmortem"]
}

Business Signals [color: yellow] {
  CheckoutRate [label: "Checkout Success Rate"]
  PaymentUnknown [label: "Payment UNKNOWN Age/Count"]
  QueueAge [label: "Oldest Queue Message"]
  SearchLag [label: "Search Index Lag"]
}

ECS > OTel: App metrics / traces
ECS > Logs: Structured logs
ALB > Metrics
RDS > Metrics
Queues > Metrics
Cache > Metrics
OTel > Metrics, Traces
ECS > ContainerInsights

Metrics > SLO
Logs > Dashboards
Traces > Dashboards
ContainerInsights > Dashboards

CheckoutRate > SLO
PaymentUnknown > Alarms
QueueAge > Alarms
SearchLag > Alarms
SLO > Dashboards, Alarms

Alarms > OnCall
OnCall > Runbooks
Runbooks > Incident
Incident > SLO: Improvement feedback

legend [position: bottom-left] {
  [color: yellow, label: "Business/customer signal"]
  [color: orange, label: "Human operations"]
}
