cloud-architecture-diagram

direction right
typeface clean
styleMode shadow
colorMode pastel

Internet [icon: globe, label: "Internet"]

Edge [label: "AWS Edge", color: blue] {
  DNS [label: "Route 53"]
  CloudFront [icon: aws-cloudfront, label: "CloudFront"]
  WAF [icon: aws-waf, label: "AWS WAF"]
}

VPC [label: "Production VPC - 3 Availability Zones", color: teal] {
  PublicTier [label: "Public Ingress and Egress", color: blue] {
    ALB [icon: aws-elb-application-load-balancer, label: "Public ALB"]
    NATA [label: "NAT Gateway AZ-A"]
    NATB [label: "NAT Gateway AZ-B"]
    NATC [label: "NAT Gateway AZ-C"]
  }

  AppTier [label: "Private Application Tier", color: green] {
    ECSA [icon: aws-fargate, label: "ECS Fargate AZ-A"]
    ECSB [icon: aws-fargate, label: "ECS Fargate AZ-B"]
    ECSC [icon: aws-fargate, label: "ECS Fargate AZ-C"]
  }

  DataTier [label: "Isolated Data Tier", color: purple] {
    RDS [icon: aws-rds, label: "RDS PostgreSQL Multi-AZ"]
    Valkey [icon: aws-elasticache, label: "ElastiCache Valkey"]
    OpenSearch [icon: aws-opensearch-service, label: "OpenSearch Service"]
  }

  PrivateAccess [label: "Private AWS Service Access", color: yellow] {
    S3Endpoint [label: "S3 Gateway Endpoint"]
    InterfaceEndpoints [label: "Interface Endpoints"]
  }
}

Security [label: "Security Controls", color: red] {
  Secrets [label: "Secrets Manager"]
  KMS [label: "AWS KMS"]
  TaskRoles [label: "ECS Task IAM Roles"]
  CloudTrail [label: "CloudTrail"]
}

Providers [label: "External Providers", color: orange] {
  Payment [label: "Payment Provider"]
  ERP [label: "ERP and Warehouse"]
  Messaging [label: "Email, SMS and Push"]
}

Internet > DNS: DNS lookup
DNS > CloudFront: Public entry
CloudFront > WAF: Protected request
WAF > ALB: HTTPS only

ALB > ECSA: Application security group
ALB > ECSB: Application security group
ALB > ECSC: Application security group

ECSA > RDS: PostgreSQL over TLS
ECSB > RDS: PostgreSQL over TLS
ECSC > RDS: PostgreSQL over TLS
ECSA > Valkey: Cache access
ECSB > Valkey: Cache access
ECSC > Valkey: Cache access
ECSA > OpenSearch: Search access
ECSB > OpenSearch: Search access
ECSC > OpenSearch: Search access

ECSA > S3Endpoint: Private S3 access
ECSB > S3Endpoint: Private S3 access
ECSC > S3Endpoint: Private S3 access
ECSA > InterfaceEndpoints: Private AWS API access
ECSB > InterfaceEndpoints: Private AWS API access
ECSC > InterfaceEndpoints: Private AWS API access

TaskRoles > ECSA: Temporary AWS credentials
TaskRoles > ECSB: Temporary AWS credentials
TaskRoles > ECSC: Temporary AWS credentials
Secrets > ECSA: Runtime secrets
Secrets > ECSB: Runtime secrets
Secrets > ECSC: Runtime secrets
KMS > RDS: Encryption at rest
KMS > Valkey: Encryption at rest
KMS > OpenSearch: Encryption at rest

ECSA > NATA: Internet egress
ECSB > NATB: Internet egress
ECSC > NATC: Internet egress
NATA > Payment: Provider calls
NATB > ERP: Enterprise integration
NATC > Messaging: Notification provider calls

legend [position: bottom-left] {
  [color: blue, label: "Public and edge"]
  [color: green, label: "Private application"]
  [color: purple, label: "Data"]
  [color: red, label: "Security controls"]
}
