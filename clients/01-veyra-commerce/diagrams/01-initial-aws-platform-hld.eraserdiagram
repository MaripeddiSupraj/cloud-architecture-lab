cloud-architecture-diagram

direction right
typeface clean
styleMode shadow
colorMode pastel

Customers [label: "Customers"] {
  WebClient [icon: browser, label: "Web"]
  MobileClient [icon: smartphone, label: "Mobile"]
}

AWSPlatform [label: "AWS Platform"] {
  Edge [label: "Edge"] {
    CloudFront [icon: aws-cloudfront, label: "CloudFront"]
    WAF [icon: aws-waf, label: "AWS WAF"]
  }

  Media [label: "Object Storage"] {
    ProductMedia [icon: aws-simple-storage-service, label: "S3 Product Media"]
  }

  VPC [label: "Application VPC"] {
    Ingress [label: "Ingress"] {
      ALB [icon: aws-elb-application-load-balancer, label: "Application Load Balancer"]
    }

    AppTier [label: "ECS Fargate Services"] {
      Experience [icon: aws-fargate, label: "Experience API"]
      Catalog [icon: aws-fargate, label: "Catalog and Pricing"]
      Cart [icon: aws-fargate, label: "Cart"]
      Checkout [icon: aws-fargate, label: "Checkout and Orders"]
      Inventory [icon: aws-fargate, label: "Inventory"]
      SearchIndexer [icon: aws-fargate, label: "Search Index Workers"]
      IntegrationWorkers [icon: aws-fargate, label: "Integration Workers"]
    }

    DataTier [label: "Data Services"] {
      PostgreSQL [icon: aws-rds, label: "RDS PostgreSQL Multi-AZ"]
      Cache [icon: aws-elasticache, label: "ElastiCache Serverless for Valkey"]
      Search [icon: aws-opensearch-service, label: "OpenSearch Service"]
    }
  }

  Async [label: "Async Integration"] {
    EventBus [icon: aws-eventbridge, label: "EventBridge"]
    WorkQueues [icon: aws-simple-queue-service, label: "SQS Work Queues"]
  }
}

ExternalSystems [label: "External Systems"] {
  Payment [label: "Payment Provider"]
  ERP [label: "ERP and Warehouse"]
  Delivery [label: "Courier and Tracking"]
  Notifications [label: "Email, SMS and Push"]
}

WebClient > CloudFront: HTTPS
MobileClient > CloudFront: HTTPS
CloudFront > WAF: Protected requests
CloudFront > ProductMedia: Cacheable media
WAF > ALB: Dynamic HTTPS

ALB > Experience: Customer APIs
Experience > Catalog: Catalog and pricing
Experience > Cart: Cart operations
Experience > Checkout: Checkout operations

Catalog > Cache: Hot reads
Catalog > PostgreSQL: Authoritative catalog state
Catalog > Search: Product discovery

Cart > Cache: Hot cart state
Cart > PostgreSQL: Durable cart state

Checkout > PostgreSQL: Order and payment state
Checkout > Inventory: Reserve stock
Inventory > PostgreSQL: Authoritative inventory state

Checkout > EventBus: Order domain events
Catalog > EventBus: Catalog domain events
EventBus > WorkQueues: Route and buffer
WorkQueues > SearchIndexer: Search work
WorkQueues > IntegrationWorkers: Integration work
SearchIndexer > Search: Idempotent indexing

Checkout > Payment: Payment request
Payment > Checkout: Payment callback
IntegrationWorkers > ERP: Inventory and fulfilment integration
IntegrationWorkers > Delivery: Shipment integration
IntegrationWorkers > Notifications: Notification delivery

legend [position: bottom-left] {
  [connection: -->, label: "Request or event flow"]
}
