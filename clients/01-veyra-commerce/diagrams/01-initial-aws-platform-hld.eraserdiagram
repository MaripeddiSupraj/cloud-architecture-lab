cloud-architecture-diagram

direction right
typeface clean
styleMode shadow
colorMode pastel

Channels [label: "Customer Channels"] {
  Web [icon: browser, label: "Web"]
  Mobile [icon: smartphone, label: "Mobile"]
}

GlobalEdge [label: "Global Edge"] {
  DNS [label: "Route 53"]
  CloudFront [icon: aws-cloudfront, label: "CloudFront"]
  WAF [icon: aws-waf, label: "AWS WAF"]
  Cognito [label: "Amazon Cognito"]
}

AWSRegion [label: "AWS Region - Mumbai"] {
  Storage [label: "Object Storage"] {
    Media [icon: aws-simple-storage-service, label: "S3 Product Media"]
  }

  VPC [label: "Production VPC"] {
    Ingress [label: "Public Ingress"] {
      ALB [icon: aws-elb-application-load-balancer, label: "Application Load Balancer"]
    }

    Services [label: "Private ECS Fargate Services"] {
      Experience [icon: aws-fargate, label: "Experience API"]
      Catalog [icon: aws-fargate, label: "Catalog and Pricing"]
      Cart [icon: aws-fargate, label: "Cart"]
      Checkout [icon: aws-fargate, label: "Checkout and Orders"]
      Inventory [icon: aws-fargate, label: "Inventory"]
    }

    Data [label: "Managed Data Services"] {
      PostgreSQL [icon: aws-rds, label: "RDS PostgreSQL Multi-AZ"]
      Cache [icon: aws-elasticache, label: "ElastiCache Serverless for Valkey"]
      Search [icon: aws-opensearch-service, label: "OpenSearch Service"]
    }
  }

  Async [label: "Asynchronous Processing"] {
    EventBus [icon: aws-eventbridge, label: "EventBridge"]
    SearchQueue [icon: aws-simple-queue-service, label: "Search Index Queue"]
    IntegrationQueue [icon: aws-simple-queue-service, label: "Integration Queue"]
    SearchWorker [icon: aws-fargate, label: "Search Index Worker"]
    IntegrationWorker [icon: aws-fargate, label: "Integration Worker"]
  }
}

External [label: "External Business Systems"] {
  Payment [label: "Payment Provider"]
  ERP [label: "ERP and Warehouse"]
  Delivery [label: "Courier and Tracking"]
  Notifications [label: "Email, SMS and Push"]
}

Web > DNS: Resolve application endpoint
Mobile > DNS: Resolve application endpoint
DNS > CloudFront: Customer traffic
CloudFront > WAF: Dynamic requests
CloudFront > Media: Static and product media
Web --> Cognito: Authenticate
Mobile --> Cognito: Authenticate

WAF > ALB: HTTPS
ALB > Experience: Customer APIs

Experience > Catalog: Browse and pricing
Experience > Cart: Cart operations
Experience > Checkout: Checkout operations

Catalog > Cache: Hot read cache
Catalog > PostgreSQL: Catalog truth
Catalog > Search: Product search

Cart > Cache: Hot cart state
Cart > PostgreSQL: Durable cart state

Checkout > Inventory: Reserve inventory
Checkout > PostgreSQL: Order and payment state
Inventory > PostgreSQL: Inventory and reservations
Checkout > Payment: Payment request and reconciliation

Catalog > EventBus: Catalog domain events
Checkout > EventBus: Order domain events

EventBus > SearchQueue: Search events
SearchQueue > SearchWorker: Buffered indexing work
SearchWorker > Search: Update derived index

EventBus > IntegrationQueue: Fulfilment and notification events
IntegrationQueue > IntegrationWorker: Buffered integration work
IntegrationWorker > ERP: Warehouse integration
IntegrationWorker > Delivery: Shipment integration
IntegrationWorker > Notifications: Customer notifications

legend [position: bottom-left] {
  [connection: -->, label: "Authentication or indirect flow"]
  [connection: >, label: "Primary request or event flow"]
}
